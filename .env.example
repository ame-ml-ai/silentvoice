# Copy to .env and adjust. All variables are optional; no secrets are required.

# Path to an Auto-AVSR VSR checkpoint. Leave empty to run without a model
# (upload, validation and mouth-region preprocessing still work; /api/recognize returns 503).
SILENTVOICE_CHECKPOINT_PATH=
# auto -> cuda if available, else cpu. "mps" is rejected (upstream CTC scorer is CUDA/CPU only).
SILENTVOICE_DEVICE=auto
SILENTVOICE_BEAM_SIZE=40
SILENTVOICE_MAX_UPLOAD_MB=50
SILENTVOICE_MAX_DURATION_S=30
SILENTVOICE_LOG_LEVEL=INFO
# JSON list of allowed browser origins for CORS
SILENTVOICE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
